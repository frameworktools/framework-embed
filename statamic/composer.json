{
    "name": "framework-cloud/statamic-embed",
    "description": "Shows Framework artifacts (models, tables, tests, figures, and charts) from framework.pub and other Framework Cloud servers in Statamic, without iframes.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "framework",
        "embed",
        "statistics"
    ],
    "require": {
        "php": ">=8.1",
        "framework-cloud/embed": "^0.1",
        "statamic/cms": "^5.0 || ^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "FrameworkCloud\\StatamicEmbed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FrameworkCloud\\StatamicEmbed\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Framework Embeds",
            "slug": "framework-embed",
            "description": "Shows Framework artifacts from framework.pub and self-hosted Framework Cloud servers."
        },
        "laravel": {
            "providers": [
                "FrameworkCloud\\StatamicEmbed\\ServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "symlink": true,
                "versions": {
                    "framework-cloud/embed": "0.1.0"
                }
            }
        }
    ]
}
