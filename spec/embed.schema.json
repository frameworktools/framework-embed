{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework.pub/schemas/framework.embed/v1.json",
  "title": "framework.embed/v1",
  "description": "An embed document from a Framework Cloud server. Fields may be added within v1; consumers ignore fields they do not know.",
  "type": "object",
  "required": ["schema", "kind", "url"],
  "properties": {
    "schema": { "const": "framework.embed/v1" },
    "key": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "latest_version": { "type": "integer", "minimum": 1 },
    "kind": {
      "type": "string",
      "description": "model, table, test, image, vega-lite, or page. Renderers treat any other value as page.",
      "examples": ["model", "table", "test", "image", "vega-lite", "page"]
    },
    "title": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "alt": { "type": ["string", "null"], "description": "A one-sentence text description for screen readers and image alt text." },
    "url": { "type": "string", "description": "The version's page." },
    "embed_url": { "type": "string" },
    "published_at": { "type": ["string", "null"] },
    "author": {
      "type": ["object", "null"],
      "properties": { "name": { "type": "string" }, "url": { "type": ["string", "null"] } }
    },
    "provider": {
      "type": ["object", "null"],
      "properties": { "name": { "type": "string" }, "url": { "type": "string" } }
    },
    "attribution": {
      "type": ["object", "null"],
      "properties": { "text": { "type": "string" }, "url": { "type": "string" } }
    },
    "data": {
      "description": "Set for model, table, and test: the framework.artifact/v1 representation as Cloud normalizes it.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/representation" }]
    },
    "spec": {
      "type": ["object", "null"],
      "description": "Set for vega-lite: the Vega-Lite specification with its data inlined."
    },
    "image": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string" },
            "content_type": { "type": ["string", "null"] },
            "width": { "type": ["integer", "null"], "minimum": 1 },
            "height": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      ]
    }
  },
  "$defs": {
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "representation": {
      "type": "object",
      "required": ["schema", "kind", "tables", "metrics"],
      "properties": {
        "schema": { "const": "framework.artifact/v1" },
        "kind": { "enum": ["model", "table", "test"] },
        "source": {
          "type": "object",
          "properties": {
            "language": { "type": "string" },
            "class": { "type": "array", "items": { "type": "string" } }
          }
        },
        "model": {
          "type": ["object", "null"],
          "properties": {
            "type": { "type": "string" },
            "family": { "type": "string" },
            "link": { "type": "string" },
            "response": { "type": "string" },
            "exponentiate": { "type": "string" }
          }
        },
        "test": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/test" }] },
        "tables": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/table" } },
        "metrics": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": { "name": { "type": "string" }, "value": { "$ref": "#/$defs/scalar" } }
          }
        },
        "formula": { "type": "string" },
        "variables": {
          "type": "array",
          "maxItems": 100,
          "description": "Models: the variables the model was fit on, from its data. Optional.",
          "items": { "$ref": "#/$defs/variable" }
        },
        "terms": {
          "type": "array",
          "maxItems": 500,
          "description": "Models: the variables, and levels, behind each coefficient table term. Optional.",
          "items": {
            "type": "object",
            "required": ["term", "parts"],
            "properties": {
              "term": { "type": "string" },
              "parts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": ["variable"],
                  "properties": { "variable": { "type": "string" }, "level": { "type": "string" } }
                }
              }
            }
          }
        },
        "truncated": { "type": "boolean" }
      }
    },
    "variable": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "role": { "enum": ["response", "predictor", "group", "weight", "offset"] },
        "type": { "enum": ["number", "categorical", "boolean", "date", "datetime", "string"] },
        "label": { "type": "string" },
        "levels": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
        "reference": { "type": "string" },
        "summary": { "type": "object", "description": "As a table column's summary, over the rows the model used." }
      }
    },
    "table": {
      "type": "object",
      "required": ["title", "columns", "rows"],
      "properties": {
        "title": { "type": "string" },
        "role": { "type": ["string", "null"], "examples": ["coefficients", "random_effects", "importance", "smooth_terms", "anova", "data"] },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "enum": ["number", "string", "boolean", "date", "datetime"] },
              "label": { "type": "string" },
              "summary": { "type": "object" }
            }
          }
        },
        "rows": { "type": "array", "maxItems": 1000, "items": { "type": "array", "items": { "$ref": "#/$defs/scalar" } } },
        "precision_note": { "type": ["string", "null"] },
        "row_count": { "type": "integer", "minimum": 0, "description": "Rows in the original table, which may exceed the rows sent." },
        "column_count": { "type": "integer", "minimum": 0, "description": "Columns in the original table, which may exceed the columns sent." },
        "truncated": { "type": "boolean" }
      }
    },
    "named": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": { "name": { "type": "string" }, "value": { "type": "number" } }
      }
    },
    "test": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "alternative": { "enum": ["two.sided", "less", "greater"] },
        "statistic": {
          "type": "object",
          "required": ["name", "value"],
          "properties": { "name": { "type": "string" }, "value": { "type": "number" } }
        },
        "parameters": { "$ref": "#/$defs/named" },
        "estimates": { "$ref": "#/$defs/named" },
        "null_value": { "$ref": "#/$defs/named" },
        "p_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "conf_int": {
          "type": "object",
          "required": ["level"],
          "properties": {
            "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "low": { "type": "number" },
            "high": { "type": "number" }
          }
        }
      }
    }
  }
}
