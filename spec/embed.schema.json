{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framework.pub/schemas/framework.embed/v1.json",
  "title": "framework.embed/v1",
  "description": "An embed document from a Framework Cloud server. Fields may be added within v1; consumers ignore fields they do not know.",
  "type": "object",
  "required": ["schema", "kind", "url"],
  "properties": {
    "schema": { "const": "framework.embed/v1" },
    "key": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "latest_version": { "type": "integer", "minimum": 1 },
    "kind": {
      "type": "string",
      "description": "model, table, test, code_snippet, dag, image, vega-lite, or page. Renderers treat any other value as page.",
      "examples": ["model", "table", "test", "code_snippet", "dag", "image", "vega-lite", "page"]
    },
    "title": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "alt": { "type": ["string", "null"], "description": "A one-sentence text description for screen readers and image alt text." },
    "url": { "type": "string", "description": "The version's page." },
    "embed_url": { "type": "string" },
    "published_at": { "type": ["string", "null"] },
    "author": {
      "type": ["object", "null"],
      "properties": { "name": { "type": "string" }, "url": { "type": ["string", "null"] } }
    },
    "provider": {
      "type": ["object", "null"],
      "properties": { "name": { "type": "string" }, "url": { "type": "string" } }
    },
    "attribution": {
      "type": ["object", "null"],
      "properties": { "text": { "type": "string" }, "url": { "type": "string" } }
    },
    "data": {
      "description": "Set for model, table, test, code_snippet, and dag: the framework.artifact/v1 representation as Cloud normalizes it.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/representation" }, { "$ref": "#/$defs/code_snippet" }, { "$ref": "#/$defs/dag" }]
    },
    "spec": {
      "type": ["object", "null"],
      "description": "Set for vega-lite: the Vega-Lite specification with its data inlined."
    },
    "image": {
      "description": "Set for image. Optional for vega-lite: a static rendering of the same chart, shown wherever the chart cannot draw.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string" },
            "content_type": { "type": ["string", "null"] },
            "width": { "type": ["integer", "null"], "minimum": 1 },
            "height": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      ]
    }
  },
  "$defs": {
    "segments": {
      "description": "Text as lines of styled segments: each line a list of [classes, text] pairs. classes is a space-separated string of [a-z0-9-] tokens, empty for plain text.",
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "minItems": 2, "maxItems": 2 }
      }
    },
    "dag": {
      "type": "object",
      "description": "A causal diagram laid out by Cloud, with the DAGitty code that defines it.",
      "required": ["schema", "kind", "dag", "dagitty"],
      "properties": {
        "schema": { "const": "framework.artifact/v1" },
        "kind": { "const": "dag" },
        "dag": {
          "type": "object",
          "required": ["width", "height", "nodes", "edges"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "height": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "nodes": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": ["name", "roles", "x", "y", "width", "height"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "roles": { "type": "array", "items": { "enum": ["exposure", "outcome", "latent", "adjusted", "selected"] } },
                  "x": { "type": "integer", "minimum": 0 },
                  "y": { "type": "integer", "minimum": 0 },
                  "width": { "type": "integer", "minimum": 0 },
                  "height": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 400,
              "items": {
                "type": "object",
                "required": ["from", "to", "type", "path", "heads"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "type": { "enum": ["->", "<->"] },
                  "path": { "type": "string", "pattern": "^[MLQZ0-9 .-]{1,400}$" },
                  "heads": { "type": "array", "items": { "type": "string", "pattern": "^[MLQZ0-9 .-]{1,400}$" } }
                }
              }
            }
          }
        },
        "display": {
          "type": "object",
          "description": "Sections the artifact's owner turned off on Framework Cloud. legend false leaves out the role legend.",
          "properties": { "legend": { "type": "boolean" } }
        },
        "dagitty": {
          "type": "object",
          "required": ["text", "lines"],
          "properties": { "text": { "type": "string" }, "lines": { "$ref": "#/$defs/segments" } }
        },
        "code": {
          "type": "object",
          "required": ["language", "text", "lines"],
          "properties": {
            "language": { "enum": ["r", "python", "stata"] },
            "text": { "type": "string" },
            "lines": { "$ref": "#/$defs/segments" }
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "effect": { "enum": ["total", "direct"] },
            "exposures": { "type": "array", "items": { "type": "string" } },
            "outcomes": { "type": "array", "items": { "type": "string" } },
            "adjustment_sets": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
            "implications": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "given"],
                "properties": { "x": { "type": "string" }, "y": { "type": "string" }, "given": { "type": "array", "items": { "type": "string" } } }
              }
            }
          }
        }
      }
    },
    "code_snippet": {
      "type": "object",
      "description": "A chunk's code and the text it printed, as a notebook showed them.",
      "required": ["schema", "kind", "source", "snippet"],
      "properties": {
        "schema": { "const": "framework.artifact/v1" },
        "kind": { "const": "code_snippet" },
        "source": {
          "type": "object",
          "required": ["language"],
          "properties": {
            "language": { "enum": ["r", "python", "stata"] },
            "file": { "type": "string", "description": "The file the chunk is in, relative to the repository." },
            "label": { "type": "string", "description": "The chunk label, cell tag, or Stata marker." },
            "lines": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }], "minItems": 2, "maxItems": 2 },
            "commit": { "type": "string" },
            "repository": { "type": "string" },
            "permalink": { "type": "string", "description": "A GitHub link to the lines at the commit." }
          }
        },
        "snippet": {
          "type": "object",
          "required": ["blocks"],
          "properties": {
            "width": { "type": "integer", "description": "Console width at the run: R width, Stata linesize." },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "text", "lines"],
                "properties": {
                  "type": { "enum": ["code", "output", "message", "warning", "error"] },
                  "text": { "type": "string", "description": "Plain text, for copying and readers that ignore styling." },
                  "lines": { "$ref": "#/$defs/segments" },
                  "folded": { "type": "boolean", "description": "Output blocks only: shown closed." },
                  "truncated": {
                    "type": "object",
                    "required": ["lines"],
                    "properties": { "lines": { "type": "integer", "minimum": 1, "description": "Lines cut from the end." } }
                  }
                }
              }
            }
          }
        },
        "display": {
          "type": "object",
          "properties": {
            "output": { "type": "boolean", "description": "false: output blocks start hidden behind the toggle." },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["rel", "url"],
                "properties": { "rel": { "enum": ["notebook", "model"] }, "url": { "type": "string" } }
              }
            }
          }
        },
        "truncated": { "type": "boolean" }
      }
    },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "representation": {
      "type": "object",
      "required": ["schema", "kind", "tables", "metrics"],
      "properties": {
        "schema": { "const": "framework.artifact/v1" },
        "kind": { "enum": ["model", "table", "test"] },
        "display": {
          "type": "object",
          "description": "Sections the artifact's owner turned off on Framework Cloud. details false leaves out a model's or test's details section.",
          "properties": { "details": { "type": "boolean" } }
        },
        "source": {
          "type": "object",
          "properties": {
            "language": { "type": "string" },
            "class": { "type": "array", "items": { "type": "string" } }
          }
        },
        "model": {
          "type": ["object", "null"],
          "properties": {
            "type": { "type": "string" },
            "family": { "type": "string" },
            "link": { "type": "string" },
            "response": { "type": "string" },
            "exponentiate": { "type": "string" },
            "inference": { "enum": ["frequentist", "bayesian"] }
          }
        },
        "test": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/test" }] },
        "tables": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/table" } },
        "metrics": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": { "name": { "type": "string" }, "value": { "$ref": "#/$defs/scalar" } }
          }
        },
        "formula": { "type": "string" },
        "variables": {
          "type": "array",
          "maxItems": 100,
          "description": "Models: the variables the model was fit on, from its data. Optional.",
          "items": { "$ref": "#/$defs/variable" }
        },
        "terms": {
          "type": "array",
          "maxItems": 500,
          "description": "Models: the variables, and levels, behind each coefficient table term. Optional.",
          "items": {
            "type": "object",
            "required": ["term", "parts"],
            "properties": {
              "term": { "type": "string" },
              "parts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": ["variable"],
                  "properties": { "variable": { "type": "string" }, "level": { "type": "string" } }
                }
              }
            }
          }
        },
        "truncated": { "type": "boolean" }
      }
    },
    "variable": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "role": { "enum": ["response", "predictor", "group", "weight", "offset"] },
        "type": { "enum": ["number", "categorical", "boolean", "date", "datetime", "string"] },
        "label": { "type": "string" },
        "levels": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
        "reference": { "type": "string" },
        "summary": { "type": "object", "description": "As a table column's summary, over the rows the model used." }
      }
    },
    "table": {
      "type": "object",
      "required": ["title", "columns", "rows"],
      "properties": {
        "title": { "type": "string" },
        "role": { "type": ["string", "null"], "examples": ["coefficients", "random_effects", "importance", "smooth_terms", "anova", "priors", "data"] },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "enum": ["number", "string", "boolean", "date", "datetime"] },
              "label": { "type": "string" },
              "summary": { "type": "object" }
            }
          }
        },
        "rows": { "type": "array", "maxItems": 1000, "items": { "type": "array", "items": { "$ref": "#/$defs/scalar" } } },
        "precision_note": { "type": ["string", "null"] },
        "row_count": { "type": "integer", "minimum": 0, "description": "Rows in the original table, which may exceed the rows sent." },
        "column_count": { "type": "integer", "minimum": 0, "description": "Columns in the original table, which may exceed the columns sent." },
        "truncated": { "type": "boolean" }
      }
    },
    "named": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": { "name": { "type": "string" }, "value": { "type": "number" } }
      }
    },
    "test": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "alternative": { "enum": ["two.sided", "less", "greater"] },
        "statistic": {
          "type": "object",
          "required": ["name", "value"],
          "properties": { "name": { "type": "string" }, "value": { "type": "number" } }
        },
        "parameters": { "$ref": "#/$defs/named" },
        "estimates": { "$ref": "#/$defs/named" },
        "null_value": { "$ref": "#/$defs/named" },
        "p_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "conf_int": {
          "type": "object",
          "required": ["level"],
          "properties": {
            "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "low": { "type": "number" },
            "high": { "type": "number" }
          }
        }
      }
    }
  }
}
